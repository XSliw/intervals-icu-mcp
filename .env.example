# Intervals.icu API Credentials
# Get these from https://intervals.icu/settings

# Your API key (found in Developer section of settings)
INTERVALS_ICU_API_KEY=your_api_key_here

# Your athlete ID (format: i123456, found in your profile URL)
INTERVALS_ICU_ATHLETE_ID=i123456

# Optional: include `fetched_at` + `query_type` in every response's metadata
# block. Off by default to keep responses compact; enable for debugging.
# INTERVALS_ICU_DEBUG_METADATA=false

# Remote HTTP MCP protection. Required whenever `intervals-icu-mcp` is run
# with `--transport http`. Generate one random value of at least 32 characters.
# MCP_JWT_SECRET=replace_with_a_long_random_secret
# MCP_JWT_ISSUER=telegram-intervals-bot
# MCP_JWT_AUDIENCE=intervals-icu-mcp

# Telegram bridge. Deploy this as a SEPARATE Render Web Service with the start
# command `intervals-icu-telegram-bot`; never commit actual values to this file.
# TELEGRAM_BOT_TOKEN=token_from_botfather
# TELEGRAM_WEBHOOK_SECRET=another_long_random_secret
# ALLOWED_TELEGRAM_USER_IDS=123456789
# AGENTROUTER_API_KEY=your_agentrouter_key
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# AGENTROUTER_MODEL=exact_model_id_from_agentrouter_dashboard
# MCP_URL=https://your-private-or-protected-mcp-service.onrender.com/mcp
# MCP_JWT_SECRET=must_match_the_mcp_service_secret
# PUBLIC_BASE_URL=https://your-telegram-bot-service.onrender.com
# AUTO_SET_WEBHOOK=true
